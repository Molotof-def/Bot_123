{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": [ "ES2022" ],
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strict": false,
        "skipLibCheck": true,
        "noEmitOnError": false,
        "outDir": "./dist"
    },
    "include": [ "src/**/*" ]
}